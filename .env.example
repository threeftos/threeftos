# --- Google Sheet (your weekly inventory) ---
# See README for how to get this "publish to web" CSV link.
GOOGLE_SHEET_CSV_URL=

# --- Supabase (free database for orders, sold items, reviews) ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (free email notifications for each order) ---
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com

# --- Your own password for /admin/orders and /admin/reviews ---
ADMIN_PASSWORD=choose-a-password

# --- Your deployed site URL (used in sitemap + checkout redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
